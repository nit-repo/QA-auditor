# Copy to .env for local use, or set these as Railway service variables.

# Port the server binds to. Railway injects this automatically.
PORT=3500

# Where audit reports are written. On Railway, point this at a mounted volume
# (e.g. /data/reports) or reports are lost on redeploy.
# REPORTS_DIR=/data/reports

# Shared secret. When set, POST /api/report requires an X-QA-Token header, and
# the bookmarklet must be built with a matching token:
#   npm run build -- --token "$QA_API_TOKEN" --endpoint https://<app>.up.railway.app/api/report
# Leave unset for local development.
# QA_API_TOKEN=change-me

# Maximum reports retained on disk; the oldest are pruned beyond this.
# MAX_REPORTS=500
